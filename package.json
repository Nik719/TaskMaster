{
  "name": "taskmaster",
  "version": "1.0.0",
  "description": "TaskMaster \u2013 a collaborative task tracking REST API (Node.js, Express, PostgreSQL, Prisma)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "vitest": "5.1.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}

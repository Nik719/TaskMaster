# ─────────────────────────────────────────────────────────────
# TaskMaster environment variables.
# Copy this file to .env and adjust. Never commit .env.
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection strings. These defaults match docker-compose.yml.
DATABASE_URL=postgresql://taskmaster:taskmaster@localhost:5432/taskmaster
# Used only by `npm test`. Must be a DIFFERENT database: tests wipe it.
TEST_DATABASE_URL=postgresql://taskmaster:taskmaster@localhost:5432/taskmaster_test

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of reverse proxies in front of the app (0 locally, usually 1 when deployed).
TRUST_PROXY=0

# ── Authentication ──
# Secret for signing access tokens (JWT). At least 32 characters; use a long random value
# in production:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access token lifetime ("15m", "1h", ...). Clients renew it via POST /auth/refresh.
JWT_ACCESS_EXPIRES_IN=15m
# Days a login stays valid without use (refresh token lifetime).
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor (higher = slower hashing = harder to brute-force).
BCRYPT_SALT_ROUNDS=12

# ── Attachments ──
# Folder where uploaded files are stored (created if missing).
UPLOAD_DIR=uploads
# Largest accepted upload in megabytes.
MAX_UPLOAD_MB=10

// TaskMaster database schema (PostgreSQL via Prisma 7).
//
// Conventions:
// - UUID primary keys, so IDs can't be guessed or enumerated.
// - Table names are snake_case plurals (@@map); fields stay camelCase in JS.
// - Every foreign key states its onDelete behaviour explicitly.

generator client {
  // "prisma-client-js" generates plain JavaScript into node_modules/@prisma/client.
  // (The newer "prisma-client" generator emits TypeScript source, which a JS project can't run directly.)
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.js (Prisma 7+), not here.
}

// ─────────────────────────────────────────────────────────────
// Users & authentication
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique // always stored lower-cased (see auth.schemas.js)
  passwordHash String
  name         String   @db.VarChar(100)
  bio          String?  @db.VarChar(500)
  avatarUrl    String?  @db.VarChar(2048)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  ownedProjects   Project[]           @relation("ProjectOwner")
  memberships     ProjectMember[]
  sentInvitations ProjectInvitation[] @relation("InvitedBy")
  createdTasks    Task[]              @relation("TaskCreator")
  assignedTasks   Task[]              @relation("TaskAssignee")
  comments        Comment[]
  attachments     Attachment[]

  @@map("users")
}

// One row per signed-in device. The access token (JWT) carries the session ID, and the
// auth middleware checks that the session is still active, so logout takes effect
// immediately instead of waiting for the JWT to expire.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  // SHA-256 of the current refresh token secret. The raw secret only ever lives in the
  // client's httpOnly cookie, so a database leak doesn't leak usable tokens.
  refreshTokenHash String
  userAgent        String?   @db.VarChar(512)
  ip               String?   @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────
// Projects (teams), membership and invitations
// ─────────────────────────────────────────────────────────────

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
}

// A project is a team: a group of members working on a shared set of tasks.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(2000)
  ownerId     String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict: the owner can't be deleted while they still own projects.
  owner       User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  invitations ProjectInvitation[]
  tasks       Task[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The composite key doubles as the index for "is this user a member of this project?",
  // the check behind almost every request.
  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

// Invitations are addressed to an email, so people can be invited before they sign up.
model ProjectInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @db.Uuid
  email       String
  invitedById String           @db.Uuid
  role        ProjectRole      @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([projectId, status])
  @@map("project_invitations")
}

// ─────────────────────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────────────────────

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

// Declared low → high so ORDER BY priority sorts by importance.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(200)
  description String?      @db.VarChar(10000)
  status      TaskStatus   @default(OPEN)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  // Set when status becomes COMPLETED, cleared when it moves away again.
  completedAt DateTime?
  // null = a personal task, visible only to its creator.
  projectId   String?      @db.Uuid
  creatorId   String       @db.Uuid
  assigneeId  String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    Comment[]
  attachments Attachment[]

  // Indexes follow the most common list queries: a project's board filtered by status,
  // "assigned to me" filtered by status, my personal tasks, and sorting by due date.
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([creatorId])
  @@index([dueDate])
  @@map("tasks")
}

// ─────────────────────────────────────────────────────────────
// Collaboration: comments and attachments
// ─────────────────────────────────────────────────────────────

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @db.Uuid
  authorId  String    @db.Uuid
  body      String    @db.VarChar(5000)
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Comments are always read per task, oldest first.
  @@index([taskId, createdAt])
  @@map("comments")
}

// Metadata only: the bytes live in UPLOAD_DIR under storageKey (see src/storage/).
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  uploaderId   String   @db.Uuid
  originalName String   @db.VarChar(255)
  // Random server-side file name; never derived from user input.
  storageKey   String   @unique @db.VarChar(100)
  mimeType     String   @db.VarChar(255)
  size         Int
  createdAt    DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("attachments")
}
